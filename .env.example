# NSM PQM Prototype — environment template.
# Copy to `.env.local` and edit. Anything prefixed `NEXT_PUBLIC_` is inlined
# into client bundles at build time, so do NOT put secrets behind that prefix.

# ----- Agency branding (PR-RID-B) ----------------------------------------
# Short English abbreviation rendered in sidebar/header/page titles.
# Defaults to 'RID' (Royal Irrigation Department) when unset.
NEXT_PUBLIC_AGENCY_NAME=RID

# Full Thai agency name. Defaults to 'กรมชลประทาน' when unset.
NEXT_PUBLIC_AGENCY_NAME_THAI=กรมชลประทาน

# ----- Persistence backend (PR-21b) --------------------------------------
# Drives `getRepositories()`. Leave unset for the default `db` backend
# (Postgres via DATABASE_URL, or ephemeral pglite when DATABASE_URL is unset).
# 'dual' is a no-op alias retained for back-compat with the PR-20 soak.
# 'in_memory' is no longer supported and falls back to 'db' with a warning.
# PERSISTENCE_BACKEND=db

# Postgres connection string (required in production; optional in dev).
# DATABASE_URL=
