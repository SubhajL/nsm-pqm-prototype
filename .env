# Committed project defaults (NO secrets — this file is tracked in git).
# Next.js precedence (later overrides earlier):
#   .env  <  .env.local  <  process.env (e.g. Vercel dashboard vars)
# Put secrets (DATABASE_URL, tokens) in .env.local ONLY — it is gitignored.

# ----- งวดงาน-driven payment flow (PR-23) --------------------------------
# Enables work-period → delivery-slip → committee-inspection → payment-voucher.
#   FEATURE_RID_PAYMENT_FLOW            — server flag; ungates the API routes.
#   NEXT_PUBLIC_FEATURE_RID_PAYMENT_FLOW — client mirror; shows the งวดงาน nav item.
FEATURE_RID_PAYMENT_FLOW=true
NEXT_PUBLIC_FEATURE_RID_PAYMENT_FLOW=true
